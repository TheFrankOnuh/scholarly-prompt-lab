{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thefrankonuh.github.io/scholarly-prompt-lab/schemas/spl-research-session-record.schema.json",
  "title": "SPL Research Session Record",
  "description": "A documented research conversation with a generative AI system, as stored and exported by Scholarly Prompt Lab. Schema version 0.1 (draft). Every turn and every metadata value carries its provenance; coverage is never complete while a gap is recorded. Specification: docs/research-session-protocol.md.",
  "type": "object",
  "required": ["format", "schema_version", "protocol_version", "session_id", "record_type", "turns", "metadata", "coverage", "provenance"],
  "properties": {
    "format": { "const": "spl-research-session-record" },
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+$" },
    "protocol_version": { "type": ["string", "null"], "description": "The SPL Research Session Protocol version the conversation was conducted under, or null if the protocol was not used." },
    "session_id": { "type": "string", "description": "Generated by the Lab, for example SPL-S-20261127-7F3K. Empty if the conversation was recorded without a session." },
    "conversation_id": { "type": "string" },
    "project_id": { "type": "string" },
    "record_type": { "enum": ["checkpoint", "completed_session", "record_part", "transcript", "provider_export", "manual"] },
    "title": { "type": "string" },
    "research_question": { "type": "string" },
    "created_at": { "type": "string" },
    "lab_version": { "type": "string" },
    "study": { "type": "object", "properties": { "condition": { "type": "string" }, "group": { "type": "string" } } },
    "protocol": {
      "type": "object",
      "properties": {
        "used": { "type": "boolean" },
        "reminders": { "type": ["string", "null"], "description": "\"off\" or the approximate number of substantive researcher messages between reminders." },
        "initial_prompt_copied_at": { "type": ["string", "null"] }
      }
    },
    "metadata": { "type": "object", "additionalProperties": { "$ref": "#/$defs/field" } },
    "turns": { "type": "array", "items": { "$ref": "#/$defs/turn" } },
    "gaps": { "type": "array", "items": { "$ref": "#/$defs/gap" } },
    "counts": {
      "type": "object",
      "properties": {
        "researcher_prompts": { "type": "integer", "minimum": 0 },
        "ai_responses": { "type": "integer", "minimum": 0 },
        "administrative": { "type": "integer", "minimum": 0 },
        "gaps": { "type": "integer", "minimum": 0 }
      }
    },
    "coverage": {
      "type": "object",
      "required": ["status", "basis"],
      "properties": {
        "status": { "enum": ["complete", "partial", "unknown"] },
        "basis": { "enum": ["ai_reported", "compared_with_original", "researcher_confirmed", "provider_export", "none"] },
        "prompts_missing": { "type": ["integer", "null"] },
        "responses_missing": { "type": ["integer", "null"] }
      },
      "allOf": [
        { "if": { "properties": { "status": { "const": "complete" } } }, "then": { "properties": { "basis": { "not": { "enum": ["ai_reported", "none"] } } } } }
      ]
    },
    "taxonomy_version": { "type": "string" },
    "notes": { "type": "string" },
    "discrepancies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "turn_id": { "type": ["string", "null"] },
          "status": { "enum": ["ai_differs", "ai_omitted", "ai_only", "conflict", "differs_from_copied_prompt"] },
          "imported_text": { "type": ["string", "null"] },
          "artefact": { "type": "string" },
          "resolved": { "type": "boolean" }
        }
      }
    },
    "events": { "type": "array", "items": { "type": "object", "properties": { "type": { "type": "string" }, "at": { "type": "string" }, "lab_version": { "type": "string" }, "detail": { "type": "string" } } } },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": ["origin"],
      "properties": {
        "origin": { "enum": ["system_recorded", "provider_recorded", "ai_reported", "researcher_reported", "official_documentation", "unknown"] },
        "verification": { "enum": ["unreviewed", "researcher_confirmed", "compared_with_original", "disputed", "unavailable"] },
        "source_ref": { "type": "string" },
        "recorded_at": { "type": "string" },
        "confirmed_at": { "type": "string" }
      }
    },
    "assertion": {
      "type": "object",
      "required": ["status", "provenance"],
      "properties": {
        "value": {},
        "status": { "enum": ["known", "confirmation_required", "unknown", "not_exposed", "not_applicable"] },
        "provenance": { "$ref": "#/$defs/provenance" },
        "reason": { "type": "string" },
        "supersedes": { "type": "integer", "minimum": 0 }
      }
    },
    "field": {
      "type": "object",
      "required": ["assertions"],
      "properties": {
        "assertions": { "type": "array", "items": { "$ref": "#/$defs/assertion" }, "description": "Every value ever recorded for this field, oldest first. Assertions are never overwritten." },
        "resolution": { "type": "object" }
      }
    },
    "turn": {
      "type": "object",
      "required": ["turn_id", "role", "text", "kind", "provenance"],
      "properties": {
        "turn_id": { "type": "string" },
        "position": { "type": ["integer", "null"], "minimum": 1 },
        "parent_id": { "type": ["string", "null"] },
        "role": { "enum": ["researcher", "ai", "system"] },
        "kind": { "enum": ["substantive", "administrative"] },
        "text": { "type": "string" },
        "text_status": { "enum": ["original", "ai_reproduced", "reconstructed", "researcher_corrected"] },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "timestamp": { "type": ["string", "null"] },
        "model": { "$ref": "#/$defs/field" },
        "source_ids": { "type": "array", "items": { "type": "string" } },
        "classification": {
          "type": "array",
          "items": { "type": "object", "required": ["category"], "properties": { "category": { "type": "string" }, "status": { "enum": ["researcher", "suggested"] }, "note": { "type": "string" } } }
        },
        "evaluation": {
          "type": "object",
          "properties": {
            "scores": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[1-5]$" } },
            "not_applicable": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
            "evaluator": { "type": "string" },
            "notes": { "type": "string" },
            "recorded_at": { "type": "string" }
          }
        },
        "corrections": { "type": "array", "items": { "type": "object", "properties": { "old": { "type": "string" }, "new": { "type": "string" }, "reason": { "type": "string" }, "at": { "type": "string" } } } },
        "regenerated_from": { "type": ["string", "null"] },
        "edited_from": { "type": ["string", "null"] },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "gap": {
      "type": "object",
      "required": ["missing"],
      "properties": {
        "after_turn": { "type": ["string", "null"] },
        "missing": { "enum": ["researcher_prompt", "ai_response", "both", "unknown"] },
        "reason": { "type": "string" },
        "reported_by": { "enum": ["ai", "researcher", "lab_alignment"] },
        "resolved": { "type": "boolean" }
      }
    }
  }
}
